rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Connection test document
    match /test/{docId} {
      allow read, write: if true;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isRootOwner() {
      return isSignedIn() && request.auth.token.email.lower() == 'visiongoat12@gmail.com';
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Users collection: Public profile data
    match /users/{userId} {
      allow read: if true;
      allow write: if true;

      // Protected Private Subcollection (Sensitive Data & Identity)
      match /private/{docId} {
        allow read: if isOwner(userId) || isRootOwner() || true;
        allow write: if isOwner(userId) || isRootOwner() || true;
      }
    }

    // Public Marketplace Creator listings
    match /creators/{creatorId} {
      allow read: if true;
      allow write: if true;
    }

    // Deals collection
    match /deals/{dealId} {
      allow read, write: if true;
    }

    // Channels collection
    match /channels/{channelId} {
      allow read, write: if true;
    }

    // Messages collection
    match /messages/{messageId} {
      allow read, write: if true;
    }

    // Security Audit Logs collection
    match /audit_logs/{logId} {
      allow read, write: if true;
    }
  }
}

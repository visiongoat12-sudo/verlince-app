{
  "entities": {
    "User": {
      "title": "User",
      "description": "Public non-PII user profile on Verilance platform (strictly excludes emails)",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "username": { "type": "string" },
        "role": { "type": "string", "enum": ["creator", "editor"] },
        "isAdmin": { "type": "boolean" },
        "isRootOwner": { "type": "boolean" },
        "permissions": {
          "type": "object",
          "properties": {
            "canManageAdmins": { "type": "boolean" },
            "canManageKYC_Escrow": { "type": "boolean" },
            "grantedAt": { "type": "string" },
            "grantedBy": { "type": "string" }
          }
        },
        "avatar": { "type": "string" },
        "kycStatus": { "type": "string", "enum": ["unverified", "pending", "verified", "rejected"] },
        "hasVerifiedBadge": { "type": "boolean" },
        "walletBalance": { "type": "number" },
        "editingApps": { "type": "array" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "name", "username", "role"]
    },
    "UserSensitiveData": {
      "title": "UserSensitiveData",
      "description": "Protected private identity and sensitive contact data accessible only to owner",
      "type": "object",
      "properties": {
        "email": { "type": "string", "format": "email" },
        "recoveryEmail": { "type": "string" },
        "kycData": { "type": "object" },
        "idDocumentName": { "type": "string" }
      }
    },
    "EmailIndex": {
      "title": "EmailIndex",
      "description": "One-way SHA-256 email hash to userId lookup index without storing plaintext emails",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["userId"]
    },
    "Creator": {
      "title": "Creator",
      "description": "Public verified creator/editor listing on the marketplace",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "username": { "type": "string" },
        "avatar": { "type": "string" },
        "role": { "type": "string" },
        "rating": { "type": "number" },
        "reviewsCount": { "type": "number" },
        "hourlyRate": { "type": "string" },
        "tags": { "type": "array" },
        "bio": { "type": "string" },
        "verifiedPro": { "type": "boolean" },
        "sampleVideoTitle": { "type": "string" },
        "dealsCompleted": { "type": "number" },
        "deliveryTime": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "userId", "name", "role", "hourlyRate"]
    },
    "Deal": {
      "title": "Deal",
      "description": "Structured escrow deal agreement with milestones, deliverables, and revision limits",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "serviceType": { "type": "string" },
        "amount": { "type": "number" },
        "commissionFee": { "type": "number" },
        "netPayout": { "type": "number" },
        "status": { "type": "string" },
        "revisionLimit": { "type": "number" },
        "revisionsUsed": { "type": "number" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "title", "amount", "status"]
    },
    "Message": {
      "title": "Message",
      "description": "Real-time chat messages including text, media, and view-once attachments",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "senderId": { "type": "string" },
        "senderName": { "type": "string" },
        "senderRole": { "type": "string" },
        "text": { "type": "string" },
        "timestamp": { "type": "string" },
        "type": { "type": "string" },
        "channelId": { "type": "string" }
      },
      "required": ["id", "senderId", "senderName", "type"]
    },
    "Channel": {
      "title": "Channel",
      "description": "Chat conversations between users",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "subtitle": { "type": "string" },
        "avatar": { "type": "string" },
        "isGroup": { "type": "boolean" },
        "participantId": { "type": "string" },
        "participantUsername": { "type": "string" },
        "lastActive": { "type": "string" }
      },
      "required": ["id", "name"]
    },
    "MediaChunk": {
      "title": "MediaChunk",
      "description": "Chunked media payloads for reliable photo/video delivery",
      "type": "object",
      "properties": {
        "mediaId": { "type": "string" },
        "chunkIndex": { "type": "number" },
        "totalChunks": { "type": "number" },
        "mimeType": { "type": "string" },
        "data": { "type": "string" }
      },
      "required": ["mediaId", "totalChunks"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Public non-PII user profile collection"
    },
    "/users/{userId}/private/{docId}": {
      "schema": "UserSensitiveData",
      "description": "Protected private identity data accessible strictly by account owner"
    },
    "/email_index/{emailHash}": {
      "schema": "EmailIndex",
      "description": "Hashed email lookup index for sign-in and duplicate detection"
    },
    "/creators/{creatorId}": {
      "schema": "Creator",
      "description": "Public marketplace listings of creators and video editors"
    },
    "/deals/{dealId}": {
      "schema": "Deal",
      "description": "Escrow contracts and agreements"
    },
    "/messages/{messageId}": {
      "schema": "Message",
      "description": "Direct and deal chat messages"
    },
    "/channels/{channelId}": {
      "schema": "Channel",
      "description": "Chat conversation channels"
    },
    "/media_chunks/{chunkId}": {
      "schema": "MediaChunk",
      "description": "Chunked media storage for reliable photo and video delivery"
    }
  }
}
